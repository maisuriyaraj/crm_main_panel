# Backend API base URL (trailing slash required). Read by lib/constants.ts as the
# shared Axios baseURL; when it is unset the app falls back to http://localhost:5000/api/,
# so every deployed build must set it.
# NEXT_PUBLIC_API_URL=http://localhost:5000/api/
# NEXT_PUBLIC_API_URL=http://3.107.4.234:5000/api/
NEXT_PUBLIC_API_URL=https://orbitops.duckdns.org/api/

# Public site origin used for SEO/social links (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
